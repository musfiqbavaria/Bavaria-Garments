# ---------------------------------------------------------------------------
# Emerald Rozalia - Project 1 : environment template
#
# Copy to .env and replace every value marked CHANGE ME before deploying.
# .env is gitignored and must never be committed: it holds live credentials.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The application refuses to start when DJANGO_DEBUG=0 and DJANGO_SECRET_KEY is
# still one of the development values that shipped with the package, because
# those are public.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
# 1 for local development only. Never 1 on a server: DEBUG responses include a
# full traceback with source and settings.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-dev-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- transport security -----------------------------------------------------
# Leave at 0 until the HTTPS server block in nginx/default.conf is enabled and a
# certificate is mounted. Setting it to 1 without TLS makes Django redirect
# every request to https:// and, with nothing listening on 443, the site becomes
# unreachable. Turning it on enables the SSL redirect, secure session and CSRF
# cookies, and HSTS.
DJANGO_SECURE_SSL=0
DJANGO_HSTS_SECONDS=31536000

# --- database ---------------------------------------------------------------
POSTGRES_DB=emerald_rozalia_project1
POSTGRES_USER=emerald
POSTGRES_PASSWORD=emerald_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- redis: celery broker and the login-throttle cache ----------------------
REDIS_URL=redis://redis:6379/0

# --- locale -----------------------------------------------------------------
# NOTE: reporting and the attendance engine are documented as Bangladesh-local
# 08:00/13:00/20:00 but compute against this timezone, and Celery beat runs in
# UTC because CELERY_TIMEZONE is unset. Do not treat the report slots as
# Bangladesh time until that is fixed - see TECHNICAL_ASSESSMENT.md 5.5.
TIME_ZONE=Europe/Dublin

# --- sessions and sign-in ---------------------------------------------------
DJANGO_SESSION_AGE=43200
DJANGO_LOGIN_ATTEMPT_LIMIT=10
DJANGO_LOGIN_ATTEMPT_WINDOW=900

# --- uploads ----------------------------------------------------------------
# Keep in step with client_max_body_size in nginx/default.conf.
DJANGO_MAX_UPLOAD_BYTES=52428800

# --- logging ----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Refused access attempts are logged to
# portal.authorization at WARNING and are worth shipping to a SIEM.
DJANGO_LOG_LEVEL=INFO

# --- first-run administrator ------------------------------------------------
# CHANGE ME. Used once by `manage.py seed_project1`, then change the password.
# Passwords must now satisfy Django's validators (12 characters minimum, not a
# common password, not entirely numeric).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMeNow-2026

# --- business rules ---------------------------------------------------------
# Bangladesh overseas receipt incentive. Configuration only: validate legal
# eligibility before posting an incentive as earned income.
BANGLADESH_OVERSEAS_INCENTIVE_RATE=2.5

# --- backups ----------------------------------------------------------------
# For production, point BACKUP_DIR at storage on another host or volume. A
# backup that lives on the machine it protects is not a backup.
# BACKUP_DIR=/srv/backups/emerald-rozalia
BACKUP_RETENTION_DAYS=30
