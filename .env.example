# ===========================================================================
# Emerald Rozalia - Project 1 : environment template
#
# Copy to .env and replace every value marked CHANGE ME.
# .env is gitignored and excluded from the Docker image. Never commit it.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The names below are canonical. For convenience settings.py also accepts the
# shorter unprefixed spellings - SECRET_KEY, DEBUG, ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS, DB_*, DEFAULT_CURRENCY - and the prefixed name wins if
# both are set. Prefer the canonical name in new files.
#
# The application refuses to start when DEBUG is off and the secret key is still
# a known placeholder, because those values are public.
# ===========================================================================

# --- core -------------------------------------------------------------------
# 1 for local development only. Never on a server: DEBUG responses carry a full
# traceback with source and settings. Accepts 1/true/yes/on.
DJANGO_DEBUG=1
# CHANGE ME before any deployment.
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# On a server, add your domain and public IP but KEEP localhost and 127.0.0.1:
# the container health check calls http://127.0.0.1:8000/login/ and Django
# rejects any host absent from this list, which marks the container unhealthy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- transport security -----------------------------------------------------
# Leave at 0 until the HTTPS server block in nginx/default.conf is enabled and a
# certificate is mounted. Setting it to 1 without TLS makes Django redirect every
# request to https:// and, with nothing listening on 443, the site becomes
# unreachable. Enabling it turns on the SSL redirect, secure session and CSRF
# cookies, and HSTS.
DJANGO_SECURE_SSL=0
DJANGO_HSTS_SECONDS=31536000

# --- database ---------------------------------------------------------------
# postgres (default, and the deployment target) or sqlite.
#
# sqlite is for local development only - no concurrent writes, and the scoping
# and reporting queries are written for Postgres. It exists so the project can be
# run without Docker or the psycopg driver.
DB_ENGINE=postgres
DB_NAME=db.sqlite3

# Used when DB_ENGINE=postgres. CHANGE the password.
POSTGRES_DB=emerald_rozalia_project1
POSTGRES_USER=emerald
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_CONN_MAX_AGE=60

# --- redis: celery broker and the login-throttle cache ----------------------
# The throttle needs a shared cache: a per-process one could be bypassed by
# hitting a different gunicorn worker. It fails open if Redis is unreachable.
REDIS_URL=redis://redis:6379/0

# --- locale -----------------------------------------------------------------
# The operating clock. The attendance engine anchors check-in, breaks and
# checkout against this zone, report_date is stamped in it, and Celery beat
# inherits it, so the 08:00/13:00/20:00 slots fire at those times here.
# Asia/Dhaka is where the workforce and production are, and it does not observe
# DST.
#
# CHANGING THIS CHANGES PAYROLL. Do not set it to an office timezone to make
# timestamps read nicely for HQ: an Irish clock measured a Dhaka 08:00 check-in
# against an Irish 08:00 anchor, four to five hours out, and corrupted late,
# early-leave, worked and unpaid minutes along with the cost derived from them.
#
# Individual sites can carry their own clock on OrganizationNode.timezone, which
# is what the attendance engine actually uses; this is the fallback.
TIME_ZONE=Asia/Dhaka

# --- currency ---------------------------------------------------------------
# Consolidated reporting currency. Amounts in other currencies convert into it
# before any figure that spans entities is totalled. A missing or stale rate is
# never treated as 1.0 - the report says it is incomplete instead.
BASE_CURRENCY=EUR

# Daily rate feed. Empty means no outbound request is made and rates are
# maintained by Finance in admin. Any provider returning
# {"base": "EUR", "rates": {...}} works, e.g. https://api.frankfurter.app/latest
# (ECB rates, no key needed). https is required.
#
# Only public reference rates are fetched, so no company data leaves the estate.
# Even so, an external service needs written authorisation before use.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_TIMEOUT=10
# Refuse to convert with a rate older than this, rather than reporting stale
# figures as current.
EXCHANGE_RATE_MAX_AGE_DAYS=7

# --- organisation scoping ---------------------------------------------------
# 0 means records with no site assigned stay visible to every scope, which is
# required while the backfill is outstanding. Run `manage.py report_unscoped`,
# assign the sites it lists, then set this to 1.
TENANCY_STRICT=0

# --- sessions and sign-in ---------------------------------------------------
DJANGO_SESSION_AGE=43200
DJANGO_LOGIN_ATTEMPT_LIMIT=10
DJANGO_LOGIN_ATTEMPT_WINDOW=900

# --- uploads ----------------------------------------------------------------
# Keep in step with client_max_body_size in nginx/default.conf.
DJANGO_MAX_UPLOAD_BYTES=52428800

# --- email ------------------------------------------------------------------
# The console backend prints instead of sending, so development never mails a
# real buyer or member of staff by accident. To send for real, switch to:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill in the host and credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@emeraldrozalia.com
SERVER_EMAIL=no-reply@emeraldrozalia.com

# --- external integrations --------------------------------------------------
# NO CODE SENDS THROUGH THESE YET. The Communication Center represents the
# WhatsApp, SMS, voice and video channels as connector-backed message queues; an
# actual delivery implementation is still outstanding. Filling these in does not
# enable anything.
#
# Company policy requires written authorisation before any external service is
# used and before any company data is sent to one. That covers every value in
# this block.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# An AI provider key would send whatever is passed to it outside the estate.
# Treat wiring this up as a decision needing sign-off, not a config change.
OPENAI_API_KEY=

# --- logging ----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Refused access attempts are logged to
# portal.authorization at WARNING and are worth shipping to a SIEM.
DJANGO_LOG_LEVEL=INFO

# --- audit retention --------------------------------------------------------
# AuditMiddleware writes one row per authenticated request. Trimmed weekly.
# FileAccessLog and ApprovalDecisionLog are never purged: they are the audit
# trail.
AUDIT_LOG_RETENTION_DAYS=365

# --- first-run administrator ------------------------------------------------
# CHANGE ME. Used once by `manage.py seed_project1`, then change the password in
# the application. Passwords must satisfy Django's validators: at least 12
# characters, not a common password, not entirely numeric.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# --- business rules ---------------------------------------------------------
# Bangladesh overseas receipt incentive. Configuration only: confirm legal
# eligibility before posting an incentive as earned income.
BANGLADESH_OVERSEAS_INCENTIVE_RATE=2.5

# --- backups ----------------------------------------------------------------
# For production point BACKUP_DIR at storage on another host or volume. A backup
# that lives on the machine it protects is not a backup.
# BACKUP_DIR=/srv/backups/emerald-rozalia
BACKUP_RETENTION_DAYS=30
